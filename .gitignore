# --- R / RStudio ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
# El .Rproj SÍ se versiona: así cualquiera que clone el repo abre el proyecto igual

# --- renv (librerías locales, no se versionan) ---
renv/library/
renv/local/
renv/cellar/
renv/staging/

# --- Quarto: artefactos de render (se regeneran) ---
/.quarto/
/_site/
/_book/
*_files/
*_cache/
*.html
# copia de las librerías del sitio en la raíz: la regenera cada render
/site_libs/

# --- LaTeX: subproductos de renderizar a PDF (solo la guía docente los genera) ---
*.tex
*.log

# --- Bibliografía: PDFs de terceros con copyright -> NO subir a GitHub ---
bibliografia/*.pdf

# --- Ficheros de bloqueo de las suites ofimáticas ---
# Los crea Excel (~$fichero.xlsx) o LibreOffice (.~lock.fichero#) MIENTRAS el
# documento está abierto, y los borran al cerrarlo. Si el programa se cierra mal
# se quedan huérfanos. No aportan nada al repositorio y contienen el nombre de
# usuario y el equipo de quien lo tenía abierto.
~$*
.~lock.*#

# --- Sistema ---
.DS_Store
Thumbs.db
