\@writefile{lof}{\contentsline {figure}{\numberline {33}{\ignorespaces Qué significa `riesgos proporcionales' en tiempo discreto (riesgo base creciente de juguete, HR = 2). Izquierda (escala cloglog): ese efecto es una distancia vertical fija (β); las curvas van paralelas y nunca se cruzan. Si esa distancia cambiara con los periodos, la proporcionalidad fallaría. Derecha (hazard h\_t): el grupo con la covariable alta es el de referencia con su aporte de riesgo escalado por exp(β) cada periodo ---la brecha se ensancha porque el efecto es multiplicativo---.\relax }}{133}{figure.caption.148}\protected@file@percent }
\newlabel{fig-u15-ph-ilustra}{{33}{133}{Qué significa `riesgos proporcionales' en tiempo discreto (riesgo base creciente de juguete, HR = 2). Izquierda (escala cloglog): ese efecto es una distancia vertical fija (β); las curvas van paralelas y nunca se cruzan. Si esa distancia cambiara con los periodos, la proporcionalidad fallaría. Derecha (hazard h\_t): el grupo con la covariable alta es el de referencia con su aporte de riesgo escalado por exp(β) cada periodo ---la brecha se ensancha porque el efecto es multiplicativo---.\relax }{figure.caption.148}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {34}{\ignorespaces Diagrama log-log de Kaplan-Meier por tratamiento: log(-log S(t)) frente a log(tiempo). Bajo riesgos proporcionales las dos curvas son aproximadamente paralelas. Con solo seis periodos el chequeo es grueso, pero no se aprecia cruce ni convergencia, así que la proporcionalidad para x2 es asumible.\relax }}{134}{figure.caption.149}\protected@file@percent }
\newlabel{fig-u15-km-loglog}{{34}{134}{Diagrama log-log de Kaplan-Meier por tratamiento: log(-log S(t)) frente a log(tiempo). Bajo riesgos proporcionales las dos curvas son aproximadamente paralelas. Con solo seis periodos el chequeo es grueso, pero no se aprecia cruce ni convergencia, así que la proporcionalidad para x2 es asumible.\relax }{figure.caption.149}{}}
