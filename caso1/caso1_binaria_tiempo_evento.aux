\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces Efecto de centro modelizado en la cohorte: interceptos aleatorios de los 24 centros (desviación en log-odds respecto al riesgo medio) con IC 95\%, ordenados. La dispersión del conjunto es lo que el mixto resume en sigma\_u; los centros cuyo intervalo no cruza el 0 se separan del promedio.\relax }}{108}{figure.caption.123}\protected@file@percent }
\newlabel{fig-u14-cohorte-caterpillar}{{28}{108}{Efecto de centro modelizado en la cohorte: interceptos aleatorios de los 24 centros (desviación en log-odds respecto al riesgo medio) con IC 95\%, ordenados. La dispersión del conjunto es lo que el mixto resume en sigma\_u; los centros cuyo intervalo no cruza el 0 se separan del promedio.\relax }{figure.caption.123}{}}
